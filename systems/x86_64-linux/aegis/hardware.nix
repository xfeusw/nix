    device = "/dev/disk/by-uuid/95b72281-a653-46f0-b830-42923f65742b";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/48E9-BAFA";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
